# Copier ce fichier en .env puis lancer : npm run start:postgres
PORT=3000

# memory (par défaut) ou postgres
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=restaurant
DB_PASSWORD=restaurant
DB_NAME=restaurant
# true : TypeORM crée / met à jour le schéma au démarrage (développement)
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Compte responsable (rôle ADMIN), créé au démarrage. Identifiant = UUID utilisé pour se connecter.
ADMIN_MEMBER_ID=
ADMIN_EMAIL=responsable@restaurant.fr
